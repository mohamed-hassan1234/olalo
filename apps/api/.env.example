# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=4000

# MongoDB connection (managed cluster in production; TLS required there).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=lattice

# Comma-separated origins allowed to call the public API (the public site).
PUBLIC_ORIGINS=http://localhost:3000
# Origin of the separate admin app (CORS + CSRF origin check).
ADMIN_ORIGIN=http://localhost:5173

# 32 random bytes, base64. Encrypts TOTP secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENC_KEY=

# true behind HTTPS (production). Sets the Secure flag on the admin cookie.
COOKIE_SECURE=false
# Number of trusted proxy hops in front of the API (0 = none).
TRUST_PROXY=0
# Publisher and owner actions require TOTP 2FA. Keep true outside automated tests.
REQUIRE_2FA=true

# Aggregation interval (ms). 15 minutes by default.
AGG_INTERVAL_MS=900000
# Optional: folder where the published content snapshot (content.json) is written for the CDN.
PUBLISH_DIR=
# Optional: comma-separated names masked out of feedback comments.
BLOCKED_NAMES=
