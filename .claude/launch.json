{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:memory", "-w", "@lattice/api"],
      "port": 4000,
      "url": "http://localhost:4000"
    },
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/web/scripts/serve.mjs", "apps/web/out", "3000"],
      "port": 3000
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@lattice/admin"],
      "port": 5173
    }
  ]
}
